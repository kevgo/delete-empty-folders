{
  "$schema": "https://raw.githubusercontent.com/kevgo/cucumber-sort/refs/heads/main/docs/schema.json",
  "include": [],
  "exclude": [],
  "record": true,
  "fail-fast": false,
  "keep-order": [],
  "steps": [
    "^a folder with contents:$",
    "^a .gitignore file with contents:$",
